#!/usr/bin/env bash

usage() { # {{{
    cat <<-EOT
    Usage: $0 <options> [commands]
        Options:
            -p <pod>       Specify the pod to exec into
            -n <namespace> Specify the namespace to exec into
            -w <workload>  Specify a workload (or part of it) to match
            -h             Show help / usage
EOT
} # }}}

namespace=()
context=()
tier=()

while getopts :hc:n:p:t:w: opt # {{{
do
    case $opt in
        p)
            pod=$OPTARG
            ;;
        n)
            namespace=(-n "$OPTARG")
            ;;
        c)
            context=(--context "$OPTARG")
            ;;
        w)
            workload=$OPTARG
            ;;
        t)
            tier=(-l "tier=$OPTARG")
            ;;
        h)
            usage
            exit
            ;;
        :)
            printf "Option '%s' requires an argument\n" "${OPTARG}" >&2
            usage >&2
            exit 28
            ;;
        ?)
            printf "Invalid option '%s'\n" "${OPTARG}" >&2
            usage >&2
            exit 27
            ;;
    esac
done # }}}
shift $((OPTIND-1))

if [ -n "$workload" ]
then
    mapfile -t pods < <(kubectl get pods "${context[@]}" "${namespace[@]}" "${tier[@]}" -o json | jq --arg workload "$workload" -r '.items[] | select(.metadata.labels["workload"] | test($workload)) | .metadata.name')
fi
if [ -n "${pods[0]}" ]
then
    if [ "${#pods[@]}" -eq 1 ]
    then
        index=0
    else
        index=$((RANDOM % ${#pods[@]}))
    fi
    printf "Pods are:\n"
    printf "\t%s\n" "${pods[@]}"
    pod="${pods[$index]}"
fi

if [ -z "$pod" ]
then
    if [ "${#tier[@]}" -eq 0 ]
    then
        pod=$(kubectl get pods "${context[@]}" "${namespace[@]}" -l tier=utility -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    fi
    if [ -z "$pod" ]
    then
        pod=$(kubectl get pods "${context[@]}" "${namespace[@]}" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    fi
fi

if [ -z "$pod" ]
then
    echo "No pod found, searched by label for 'tier=utility' and 'app.kubernetes.io/component=nats-box' pods. Exiting."
    exit 1
fi

printf "Pod chosen is %s\n" "$pod" >&2

if [ "$#" -eq 0 ]
then
    command=(kubectl "${context[@]}" "${namespace[@]}" "${tier[@]}" exec -it "$pod" -- /bin/bash)
    printf '%q ' "${command[@]}" >&2
    printf '\n' >&2
    kubectl "${context[@]}" "${namespace[@]}" exec -it "$pod" -- /bin/sh -c "if command -v /bin/bash >/dev/null 2>/dev/null; then exec /bin/bash; else exec /bin/sh; fi"
else
    set -x
    kubectl "${context[@]}" "${namespace[@]}" exec -it "$pod" "$@"
fi
